generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// USER
// ======================================================

model User {
  id           String   @id @default(cuid())
  campusUserId String?  @unique
  name         String
  email        String   @unique
  password     String
  profileImage String?
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ====================================================
  // FACULTY PROFILE INFORMATION
  // ====================================================

  department     String?
  designation    String?
  phone          String?
  qualification  String?
  specialization String?
  joiningDate    DateTime?
  address        String?
  city           String?
  state          String?
  officeRoom     String?
  officeHours    String?

  // ====================================================
  // EVENT ATTENDANCE
  // ====================================================

  attendances Attendance[]

  // ====================================================
  // CLASS / SUBJECT ATTENDANCE
  // ====================================================

  classAttendances ClassAttendance[]

  // ====================================================
  // STUDENT SUBJECT REGISTRATION
  // ====================================================

  studentRegistrations StudentRegistration[]

  // ====================================================
  // CERTIFICATES
  // ====================================================

  certificates Certificate[]

  // ====================================================
  // CLUB MEMBERSHIPS
  // ====================================================

  memberships Membership[]

  // ====================================================
  // APPROVAL SYSTEM
  // ====================================================

  approvalStatus  ApprovalStatus @default(PENDING)
  approvedAt      DateTime?
  rejectionReason String?

  approvals UserApproval[]

  // ====================================================
  // FACULTY CLASS SESSIONS
  // ====================================================

  facultyClassSessions ClassSession[] @relation("FacultyClassSessions")

  @@map("User")
}

// ======================================================
// SUBJECT
// ======================================================

model Subject {
  id        String   @id @default(cuid())
  name      String
  semester  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // STUDENT REGISTRATIONS
  studentRegistrations StudentRegistration[]

  // CLASS SESSIONS
  classSessions ClassSession[]

  // CLASS ATTENDANCE
  classAttendances ClassAttendance[]

  @@unique([name, semester])
  @@index([semester])
  @@map("Subject")
}

// ======================================================
// STUDENT REGISTRATION
//
// One record = one student registered for one subject
// in one semester + section.
// ======================================================

model StudentRegistration {
  id        String   @id @default(cuid())
  studentId String
  subjectId String
  semester  Int
  section   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, semester, section])
  @@index([studentId])
  @@index([subjectId])
  @@index([semester, section])
  @@map("StudentRegistration")
}

// ======================================================
// CLASS SESSION
//
// One faculty attendance marking session.
// Example:
// Semester 5 + Section A + Data Structures + 25 Aug 2026
//
// Event attendance does NOT use this model.
// ======================================================

model ClassSession {
  id          String   @id @default(cuid())
  facultyId   String
  subjectId   String
  semester    Int
  section     String
  sessionDate DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  faculty User    @relation("FacultyClassSessions", fields: [facultyId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  attendances ClassAttendance[]

  @@unique([facultyId, subjectId, semester, section, sessionDate])
  @@index([facultyId])
  @@index([subjectId])
  @@index([semester, section])
  @@index([sessionDate])
  @@map("ClassSession")
}

// ======================================================
// CLASS / SUBJECT ATTENDANCE
//
// Completely separate from Event Attendance.
// ======================================================

model ClassAttendance {
  id        String   @id @default(cuid())
  sessionId String
  studentId String
  subjectId String
  status    String   @default("Absent")
  markedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([subjectId])
  @@index([sessionId])
  @@index([status])
  @@map("ClassAttendance")
}

// ======================================================
// CLUB
// ======================================================

model Club {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  logo        String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  announcements Announcement[]
  events        Event[]
  members       Membership[]

  @@map("Club")
}

// ======================================================
// MEMBERSHIP
// ======================================================

model Membership {
  id       String   @id @default(cuid())
  userId   String
  clubId   String
  joinedAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
  @@map("Membership")
}

// ======================================================
// EVENT
//
// Used ONLY for event attendance.
// ======================================================

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  venue       String
  clubId      String
  createdAt   DateTime @default(now())
  eventDate   DateTime
  image       String?
  updatedAt   DateTime @updatedAt

  attendances Attendance[]

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@map("Event")
}

// ======================================================
// EVENT ATTENDANCE
//
// Existing event attendance remains completely separate.
// ======================================================

model Attendance {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  status    String   @default("Present")
  markedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("Attendance")
}

// ======================================================
// ANNOUNCEMENT
// ======================================================

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  clubId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@map("Announcement")
}

// ======================================================
// CERTIFICATE
// ======================================================

model Certificate {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  fileUrl   String
  title     String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Certificate")
}

// ======================================================
// NOTIFICATION
// ======================================================

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Notification")
}

// ======================================================
// ACTIVITY
// ======================================================

model Activity {
  id           String   @id @default(cuid())
  title        String
  description  String
  venue        String
  activityDate DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("Activity")
}

// ======================================================
// USER APPROVAL
// ======================================================

model UserApproval {
  id              String         @id @default(cuid())
  userId          String
  actionById      String
  status          ApprovalStatus
  rejectionReason String?
  createdAt       DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("UserApproval")
}

// ======================================================
// ENUMS
// ======================================================

enum Role {
  STUDENT
  COORDINATOR
  FACULTY
  ADMIN
  SUPER_ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
